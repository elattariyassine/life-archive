# Absolute path to your Life Archive data folder (the one containing YYYY/MM/DD/index.md).
# Leave empty to browse the built-in sample memories (read-only).
# Used by `npm run dev` and by Docker Compose, which mounts this folder into the container.
NUXT_ARCHIVE_DIR=

# Optional: host port for Docker Compose (the app is only exposed on 127.0.0.1).
# LIFE_ARCHIVE_PORT=3000

# Optional: geocoding endpoint and map style.
# NUXT_PHOTON_URL=https://photon.komoot.io/api
# NUXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
