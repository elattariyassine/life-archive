# Absolute path to your archive folder (the one containing YYYY/MM/DD/index.md).
# Leave empty to show the built-in sample memories (read-only).
NUXT_ARCHIVE_DIR=

# Docker Compose only: port and network interface on your machine.
# Keep 127.0.0.1 for a personal archive; use 0.0.0.0 to expose a public demo.
# LIFE_ARCHIVE_PORT=3000
# LIFE_ARCHIVE_BIND=127.0.0.1

# Optional: geocoding endpoint and map style.
# NUXT_PHOTON_URL=https://photon.komoot.io/api
# NUXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
